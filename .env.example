# Copiar a .env.local y completar. En Vercel se cargan en Settings > Environment Variables.

# Claude
ANTHROPIC_API_KEY=

# Login (Auth.js con Google). AUTH_SECRET se genera con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Mails que pueden entrar, separados por coma
ALLOWED_EMAILS=

# Planilla (Google Sheets) con la cuenta de servicio. Mientras se desarrolla, una COPIA de la planilla.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tal como viene en el JSON de la clave, con los saltos de línea escritos como \n
GOOGLE_PRIVATE_KEY=
SHEET_ID=
# Pestañas de la planilla Administración Contable. Las compras y los honorarios van a egresos; las ventas, a ingresos.
SHEET_TAB_EGRESOS=
SHEET_TAB_INGRESOS=

# Drive con Apps Script, versión 2 (ver apps-script/README.md): guarda cada comprobante al llegar y lo
# mueve a su carpeta al aprobarlo. Las carpetas se configuran en el script, no acá.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Cola de pendientes: una planilla APARTE (no Administración Contable), compartida con la cuenta de
# servicio como Editor. La app crea las pestañas "Cola" y "Telegram".
COLA_SHEET_ID=

# Bot de Telegram (token de BotFather). El secreto del webhook se deriva de este token.
TELEGRAM_API_KEY=
