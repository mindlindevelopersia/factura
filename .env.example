# Copiar a .env.local y completar. En Vercel se cargan en Settings > Environment Variables.

# Claude
ANTHROPIC_API_KEY=

# Login (Auth.js con Google). AUTH_SECRET se genera con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Mails que pueden entrar, separados por coma
ALLOWED_EMAILS=

# Planilla (Google Sheets) con la cuenta de servicio. Mientras se desarrolla, una COPIA de la planilla.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Tal como viene en el JSON de la clave, con los saltos de línea escritos como \n
GOOGLE_PRIVATE_KEY=
SHEET_ID=
SHEET_TAB=

# Guardado de los PDF con Apps Script (ver apps-script/README.md). Sin esto, las facturas se cargan sin link.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
