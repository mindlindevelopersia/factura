# Copiar a .env.local y completar. En Vercel se cargan en Settings > Environment Variables.

# Claude
ANTHROPIC_API_KEY=

# Login (Auth.js con Google). AUTH_SECRET se genera con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Mails que pueden entrar, separados por coma
ALLOWED_EMAILS=

# Google Sheets y Drive. Usar una COPIA de la planilla y una carpeta de prueba mientras se desarrolla.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=
SHEET_TAB=
DRIVE_FOLDER_ID=
